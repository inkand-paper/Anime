generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("USER") // USER | PREMIUM | ADMIN
  referralCode  String    @unique @default(cuid())
  referredById  String?

  referredBy  User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals   User[]  @relation("Referrals")

  accounts     Account[]
  sessions     Session[]
  profile      Profile?
  subscription Subscription?
  watchlist    WatchlistItem[]
  watchRooms   WatchRoomMember[]
  hostedRooms  WatchRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([referralCode])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  bio       String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ─── Subscription ────────────────────────────────────────────────────────────

model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  plan        String    @default("FREE") // FREE | MONTHLY | YEARLY
  status      String    @default("INACTIVE") // INACTIVE | ACTIVE | PAST_DUE | CANCELLED
  externalId  String?   @unique
  startDate   DateTime  @default(now())
  endDate     DateTime?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── Watchlist & Rooms ───────────────────────────────────────────────────────

model WatchlistItem {
  id      String   @id @default(cuid())
  userId  String
  animeId String   // AniList ID (integer as string)
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
}

model WatchRoom {
  id         String   @id @default(cuid())
  inviteCode String   @unique
  animeId    String
  episode    Int      @default(1)
  currentTime Float   @default(0)
  isPlaying  Boolean  @default(false)
  hostId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  host    User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  members WatchRoomMember[]

  @@index([inviteCode])
}

model WatchRoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room WatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
}

// ─── Host Mapping (dubbed video storage) ────────────────────────────────────

model HostMapping {
  id        String   @id @default(cuid())
  animeId   String   // AniList ID
  episode   Int
  host      String   // DOODSTREAM | VOE | FILEMOON | STREAMWISH | STREAMTAPE | MIXDROP | MEGASTREAM
  embedUrl  String
  embedType String   @default("iframe") // iframe | hls | mp4
  dubbed    Boolean  @default(true)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId, episode, host])
  @@index([animeId, episode])
}

// ─── Rate Limiting ───────────────────────────────────────────────────────────

model RateLimit {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(1)
  resetAt DateTime

  @@index([key])
  @@index([resetAt])
}
