// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource dev_db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, PREMIUM, ADMIN
  referralCode  String?   @unique
  referredBy    String?
  
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  subscription  Subscription?
  watchlist     WatchlistItem[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([referralCode])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Anime {
  id          String   @id @default(cuid())
  titleEn     String
  titleJp     String?
  titleCn     String?
  description String?
  image       String?
  banner      String?
  year        String?
  rating      Float?
  episodes    Int?
  tags        String   @default("") // Comma separated tags
  
  hostMappings HostMapping[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([titleEn])
}

model PasswordResetToken {

  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  bio       String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String   @unique
  externalId String?  @unique // Stripe/PayPal subscription ID
  status     String   @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED, CANCELLED, PAST_DUE
  plan       String   @default("FREE")     // FREE, PREMIUM
  startDate  DateTime @default(now())
  endDate    DateTime?
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([externalId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  addedAt   DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
}


// ─── Host Mapping ─────────────────────────────────────────────────────────────
// Stores embed URLs for dubbed episodes across the 7 fallback hosts.
// Populated by the upload coordinator script via registerHostMapping().

model HostMapping {
  id        String   @id @default(cuid())
  animeId   String   
  episode   Int
  hostName  String   // One of: Doodstream | VOE | Filemoon | Streamwish | Streamtape | MixDrop | Megastream
  url       String   // Full embed URL for this host
  type      String   @default("iframe") // iframe, hls, mp4
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, episode, hostName])
  @@index([animeId, episode])
}

