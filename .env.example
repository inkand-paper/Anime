# =============================================================================
# AniStream — Environment Variables
# Copy this file to .env.local, fill in the values, then run:
#   npm run setup   (runs prisma generate + prisma db push)
#   npm run dev
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development, zero setup — just leave this as-is):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL="postgresql://user:password@host:5432/anistream?sslmode=require"

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# AUTH_SECRET is required by NextAuth v5.
# Generate a secret with: npx auth secret
# Or manually: openssl rand -base64 32
AUTH_SECRET=replace_with_32_char_random_secret

# Legacy alias — kept for compatibility (use AUTH_SECRET above)
NEXTAUTH_SECRET=replace_with_32_char_random_secret
NEXTAUTH_URL=http://localhost:3000

# ── Admin accounts ───────────────────────────────────────────────────────────
# Comma-separated list of emails that get ADMIN role on first login
ADMIN_EMAILS=admin@yourdomain.com

# ── AniWatch / AllAnime Streaming API ─────────────────────────────────────────
# Required for video playback. Self-host on Railway (free):
#   1. railway.app → New Project → Deploy from GitHub
#   2. Repo: https://github.com/ghoshRitesh12/aniwatch-api
#   3. Copy the Railway URL below
# Dev fallback (rate-limited — do NOT use in production):
ANIWATCH_API_URL=https://aniwatch-api-production-4b7e.up.railway.app

# ── Billing & Webhooks ────────────────────────────────────────────────────────
WEBHOOK_SECRET=replace_with_random_webhook_secret

# ── PayPal (optional) ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Google Pay (optional) ─────────────────────────────────────────────────────
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=AniStream

# ── Email / SMTP (optional — for password reset) ──────────────────────────────
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=you@gmail.com
# EMAIL_SERVER_PASSWORD=app_password_here
# EMAIL_FROM=noreply@anistream.com
