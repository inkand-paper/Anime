# ─── AnimePortal Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# Public URL of the app (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (development default — change to PostgreSQL/MySQL for production)
DATABASE_URL="file:./dev.db"

# PostgreSQL example for production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/animaportal?schema=public"

# ─── External APIs ─────────────────────────────────────────────────────────────
# Self-hosted Consumet instance (https://github.com/consumet/consumet.ts)
# Leave empty to use the public instance (rate-limited, not recommended for production)
CONSUMET_API_URL=https://api.consumet.org

# ─── Payment Gateways (Phase 5) ────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── Email (Phase 5 — password reset, verification) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@animaportal.com

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
