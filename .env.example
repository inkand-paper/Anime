# =============================================================================
# AniStream — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — recommended):
# DATABASE_URL="postgresql://user:password@host:5432/anistream?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_32_char_random_secret
NEXTAUTH_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated emails that get ADMIN role on login
ADMIN_EMAILS=admin@yourdomain.com

# ── AniWatch Streaming API (required for video playback) ──────────────────────
# Self-host (Railway free tier — zero cost):
#   1. Go to railway.app → New Project → Deploy from GitHub
#   2. Repo: https://github.com/ghoshRitesh12/aniwatch-api
#   3. Copy the Railway URL here
# Public fallback (rate-limited, dev only):
ANIWATCH_API_URL=https://aniwatch-api-production-4b7e.up.railway.app

# ── AniList API ───────────────────────────────────────────────────────────────
# No API key required — public GraphQL endpoint
# ANILIST_API_URL=https://graphql.anilist.co  (default, no need to set)

# ── Billing Webhooks ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=replace_with_random_webhook_secret

# ── PayPal (optional — for subscription payments) ────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Google Pay (optional) ─────────────────────────────────────────────────────
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=AniStream

# ── Email (optional — for password reset) ────────────────────────────────────
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=you@gmail.com
# EMAIL_SERVER_PASSWORD=app_password
# EMAIL_FROM=noreply@anistream.com
