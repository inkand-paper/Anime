# ================================================================
# AniStream — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL recommended, SQLite fine for dev) ---
DATABASE_URL="postgresql://user:password@localhost:5432/anistream"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET
NEXTAUTH_URL=http://localhost:3000

# --- JWT (used in custom API routes) ---
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# --- Admin accounts (comma-separated emails) ---
ADMIN_EMAILS=admin@yourdomain.com

# --- PayPal (https://developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Stripe (optional alternative to PayPal for card payments) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Pay (configure via Google Pay & Wallet Console) ---
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=AniStream

# --- Webhook secret (shared secret for internal webhook calls) ---
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- Optional: Email (for password reset etc.) ---
# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=noreply@anistream.com

# --- Consumet API (self-host for production) ---
# Repo: https://github.com/consumet/api.consumet.org
# Self-host on Railway/Render/VPS for reliability.
# Public instance (rate-limited, dev only): https://api.consumet.org
CONSUMET_API_URL=https://api.consumet.org
